<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quick Notes — Your personal workspace</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="topbar"><div class="topbar-inner"><a class="brand" href="/"><span class="brand-mark">Q</span><span>Quick Notes</span></a><span class="topbar-note">A calm place for your ideas</span></div></header>
  <main class="page">
    <section class="hero"><div><p class="eyebrow">Personal workspace</p><h1>Keep the good thoughts close.</h1><p class="subtitle">Capture an idea, a reminder, or something worth returning to.</p></div><span class="note-count"><%= files.length %> <%= files.length === 1 ? 'note' : 'notes' %> saved</span></section>
    <div class="dashboard">
      <aside class="panel composer"><h2 class="panel-title">Create a note</h2><p class="panel-copy">Everything you write is saved to your private notebook.</p><form action="/create" method="post"><div class="field"><label for="title">TITLE</label><input id="title" type="text" name="title" placeholder="Give your note a title" required></div><div class="field"><label for="details">YOUR NOTE</label><textarea id="details" name="details" placeholder="Start writing…" required></textarea></div><button class="primary-button" type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>Save note</button></form></aside>
      <section class="notes-section"><div class="notes-heading"><h2>Recent notes</h2><span class="sort-label">Newest first</span></div><div class="notes-grid"><% if (files.length > 0) { %><% files.forEach(function(val) { %><article class="note-card"><div class="card-top"><span class="card-label">Note</span><span class="card-date">Saved</span></div><h3 title="<%= val %>"><%= val.replace(/\.txt$/, '') %></h3><p class="filename"><%= val %></p><div class="card-actions"><a href="/file/<%= val %>">Open note</a><a href="/edit/<%= val %>">Rename</a><form action="/delete/<%= val %>" method="POST" onsubmit="return confirmDelete('<%= val %>')"><button class="text-button" type="submit">Delete</button></form></div></article><% }) %><% } else { %><div class="empty-state"><div class="empty-icon">+</div><h3>Your notebook is ready.</h3><p>Create your first note using the editor on the left.</p></div><% } %></div></section>
    </div>
  </main>
  <script>function confirmDelete(filename) { return confirm(`Delete “${filename}”? This cannot be undone.`); }</script>
</body>
</html>
